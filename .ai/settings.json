{
    "agent_configuration": {
        "agent_name": "IPL-Dashboard-Builder",
        "mode": "strict-execution",
        "allow_hallucination": false,
        "context_dependency": "absolute"
    },
    "project_specifications": {
        "language": "Python",
        "minimum_version": "3.10",
        "architecture_pattern": "Three-Tier Decoupled REST",
        "target_platform": "Responsive Web Browser"
    },
    "environment_ports": {
        "data_generator_host": "127.0.0.1",
        "data_generator_port": null,
        "middle_layer_host": "127.0.0.1",
        "middle_layer_port": 5000,
        "frontend_host": "127.0.0.1",
        "frontend_port": 8501
    },
    "dependency_manifest": {
        "pip_packages": [
            "streamlit==1.32.0",
            "flask==3.0.2",
            "flask-cors==4.0.0",
            "requests==2.31.0"
        ],
        "cdn_resources": [
            "https://code.highcharts.com/highcharts.js",
            "https://code.highcharts.com/modules/accessibility.js"
        ]
    },
    "agent_behavior_rules": {
        "state_persistence": "in-memory only",
        "database_usage": "forbidden",
        "cross_origin_requests": "must allow all (*)",
        "ui_refresh_strategy": "st.empty baseline polling container",
        "ui_rerun_prevention": "never invoke st.rerun() in the polling block",
        "context_awareness_loop": {
            "enforce_memory_sync": true,
            "sync_instruction": "The agent MUST rewrite and update .ai/memory.md and modify statuses inside .ai/tasks.json immediately after completing any milestone. It is forbidden to proceed to a subsequent task in implementationplan.json until the context files reflect the exact active state of development."
        }
    },
    "execution_commands": {
        "step_1_start_middle_layer": "python middle_layer/app.py",
        "step_2_start_generator": "python data_generator/generator.py",
        "step_3_start_frontend": "streamlit run frontend/dashboard.py"
    }
}